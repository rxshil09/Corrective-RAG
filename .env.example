# ==============================================================================
# Hallucination-Aware RAG - Environment Configuration
# ==============================================================================

# Choose your primary LLM Provider: 'gemini' (recommended), 'openai', or 'auto'
LLM_PROVIDER=gemini

# ── 1. Google Gemini (Free tier available at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ── 2. OpenAI (Optional fallback - https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override the model name (leave blank to use provider defaults)
# Fallback Chain:
# - Primary: gemini-3.5-flash-lite (Fast & high capacity)
# - 1st Fallback: gemini-3.1-flash-lite (Triggered on 429 rate limit or error)
# - 2nd Fallback: gpt-4o-mini (OpenAI fallback)
LLM_MODEL=

# ── RAG & Hallucination Thresholds ────────────────────────────────────────────
HALLUCINATION_THRESHOLD=0.6
STRICT_MODE_THRESHOLD=0.4
MAX_REGENERATION_ATTEMPTS=3
TOP_K_RESULTS=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
