# ==============================================================================
# Hallucination-Aware RAG - Environment Configuration
# ==============================================================================

# Choose your primary LLM Provider: 'gemini'
LLM_PROVIDER=gemini

# ── Google Gemini API (Free tier available at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the model name (leave blank to use default primary)
# Active Multi-Tier Gemini Fallback Chain:
# - Primary: gemini-3.5-flash-lite (Ultra-fast & high capacity)
# - 1st Fallback: gemini-3.1-flash-lite
# - 2nd Fallback: gemini-3.8-flash
# - 3rd Fallback: gemini-3.7-flash
# - 4th Fallback: gemini-3.6-flash
# - 5th Fallback: gemini-3.5-flash
LLM_MODEL=

# ── RAG & Hallucination Thresholds ────────────────────────────────────────────
HALLUCINATION_THRESHOLD=0.6
STRICT_MODE_THRESHOLD=0.4
MAX_REGENERATION_ATTEMPTS=3
TOP_K_RESULTS=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
